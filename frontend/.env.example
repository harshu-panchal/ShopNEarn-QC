# =============================================================================
#  Frontend environment variables (Vite)
# =============================================================================
#
#  - Anything prefixed with VITE_ is inlined into the client bundle at
#    build time and is therefore PUBLIC. Never put secrets here.
#  - Copy this file to `.env` for local development and fill in the
#    values. For Netlify, configure these in
#    Site settings → Environment variables.

# -----------------------------------------------------------------------------
#  Backend API
# -----------------------------------------------------------------------------
#
#  Fully-qualified URL of the backend API, including the trailing `/api`
#  segment. The site refuses to function without this in production.
#  Example: https://api.shopandearn.com/api
VITE_API_URL=http://localhost:7000/api

# Optional explicit Socket.IO URL. Defaults to the API origin with the
# trailing `/api` stripped, which is correct for most deployments.
# VITE_SOCKET_URL=https://api.shopandearn.com

# -----------------------------------------------------------------------------
#  Google Maps (JavaScript + Places)
# -----------------------------------------------------------------------------
#
#  Lock this key down to your Netlify domain(s) under the
#  "Application restrictions → HTTP referrers" section of Google Cloud
#  Console before deploying.
VITE_GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
#  Firebase Web SDK
# -----------------------------------------------------------------------------
#
#  These values come from the Firebase console under
#  Project settings → Your apps → Web app → Config.
#  All of them are public by design.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloud Messaging Web Push certificate (Firebase console →
# Project settings → Cloud Messaging → Web configuration → Key pair).
VITE_FIREBASE_VAPID_KEY=

# -----------------------------------------------------------------------------
#  Payments (optional)
# -----------------------------------------------------------------------------
#
#  Prefer the keyId returned by POST /payments/create-order. This is only
#  a fallback if the API omits checkout.keyId.
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# -----------------------------------------------------------------------------
#  Behaviour toggles (optional)
# -----------------------------------------------------------------------------
#
#  Override how long the customer can request a return after delivery
#  (in minutes). Defaults to "2" if unset.
# VITE_RETURN_WINDOW_MINUTES=2
